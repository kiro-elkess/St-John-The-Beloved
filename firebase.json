{
  "hosting": {
    "site": "st-john-the-beloved",
    "public": ".",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "james-main/**",
      "deploy.bat",
      "**/*.bat",
      "**/*.cmd",
      "**/*.ps1",
      "**/*.sh",
      "**/*.exe",
      "package.json",
      "package-lock.json"
    ],
    "rewrites": [
      {
        "source": "/admin",
        "destination": "/james-admin.html"
      }
    ],
    "headers": [
      {
        "source": "/firebase-messaging-sw.js",
        "headers": [
          {
            "key": "Service-Worker-Allowed",
            "value": "/"
          }
        ]
      },
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Service-Worker-Allowed",
            "value": "/"
          }
        ]
      }
    ]
  }
}